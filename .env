# .env — Project configuration for orchestrator.py
#
# AUTHENTICATION: Uses Claude Code OAuth (no API key needed)
# The orchestrator calls `claude -p` which uses your existing
# Claude Code subscription session automatically.
#
# To verify: python auth.py --status

# ============================================================================
# OPTIONAL: Model overrides
# ============================================================================
HAIKU_MODEL=claude-haiku-4-5-20251001
OPUS_MODEL=claude-opus-4-7

# ============================================================================
# OPTIONAL: Output folder
# ============================================================================
OUTPUT_FOLDER=./outputs

# ============================================================================
# OPTIONAL: Google Drive
# ============================================================================
GOOGLE_DRIVE_PARENT_FOLDER_ID=
