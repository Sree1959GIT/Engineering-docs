# .env.example — Template for orchestrator configuration
#
# AUTHENTICATION: Three options (in priority order):
# ============================================================================
# 1. ENVIRONMENT VARIABLE (highest priority)
#    export ANTHROPIC_API_KEY="sk-ant-..."
#
# 2. LOCAL CREDENTIALS FILE (auto-created on first run)
#    ~/.claude-engineering/credentials.json
#    Created automatically on first run via `auth.py --setup`
#
# 3. INTERACTIVE PROMPT (fallback)
#    If no credentials found, script will prompt for API key
#
# NO NEED TO SET ANTHROPIC_API_KEY HERE unless you prefer environment variables.
# For production/CI/CD, use environment variables.
# For local development, let auth.py handle it interactively or via local credentials.

# OPTIONAL: Uncomment and set if you want to use environment variable
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# OPTIONAL: Google Drive Configuration
# ============================================================================
# If you want all engineering docs to save to a specific parent folder,
# set GOOGLE_DRIVE_PARENT_FOLDER_ID to its ID.
# Get folder ID from Google Drive URL: https://drive.google.com/drive/folders/[ID]
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ============================================================================
# OPTIONAL: Model Configuration
# ============================================================================
# If you want to override the default models (Haiku 4.5 for triage, Opus 4.8 for work)
HAIKU_MODEL=claude-haiku-4-5-20251001
OPUS_MODEL=claude-opus-4-8

# ============================================================================
# OPTIONAL: Output Configuration
# ============================================================================
# Local folder where diagrams and tables are saved before Drive upload
OUTPUT_FOLDER=./outputs

# ============================================================================
# OPTIONAL: Logging
# ============================================================================
# Set to 'DEBUG' for verbose output, 'INFO' for normal, 'ERROR' for quiet
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: Gmail Configuration (for completion notifications)
# ============================================================================
# If you enable Gmail MCP in Claude Code, set these to send summaries
GMAIL_NOTIFY_ON_COMPLETE=false
GMAIL_RECIPIENT_EMAIL=your-email@example.com

# ============================================================================
# OPTIONAL: Airtable Configuration (for connection table storage)
# ============================================================================
# If you want to persist connection tables in Airtable
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=engineering_connections

# ============================================================================
# HOW TO USE THIS FILE
# ============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env and fill in the values (at minimum, ANTHROPIC_API_KEY)
#
# 3. The orchestrator will read these automatically via python-dotenv:
#    from dotenv import load_dotenv
#    load_dotenv()
#    api_key = os.getenv("ANTHROPIC_API_KEY")
#
# ALTERNATIVELY, set environment variables directly in your shell:
#    export ANTHROPIC_API_KEY="sk-ant-..."
#    python orchestrator.py
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
# - NEVER commit .env to version control (add to .gitignore)
# - NEVER share your API keys
# - Use a secrets manager (e.g., AWS Secrets Manager, HashiCorp Vault) in production
# - Rotate keys periodically
